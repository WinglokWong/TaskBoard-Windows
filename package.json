{
  "name": "taskboard-windows",
  "productName": "TaskBoard",
  "version": "1.0.0",
  "description": "A lightweight, offline kanban board inspired by Trello. Windows version of TaskBoard.",
  "author": "Winglok",
  "private": true,
  "main": "out/main/index.js",
  "homepage": "https://github.com/WinglokWong/TaskBoard-Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/WinglokWong/TaskBoard-Windows.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "web": "vite --config vite.web.config.ts",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always",
    "check-strings": "node scripts/check-strings.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "immer": "10.2.0",
    "markdown-it": "14.3.2",
    "markdown-it-task-lists": "2.1.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
